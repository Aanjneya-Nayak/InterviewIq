# ─── Client Production Environment Variables ─────────────────────────────────
# This file is a TEMPLATE. The actual value must be set in Render Static Site
# environment variables dashboard.
#
# After deploying the server Web Service, copy its URL and update VITE_API_URL
# in the Render dashboard for the client Static Site.
#
# Format: https://<your-server-web-service-name>.onrender.com/api
# Example: https://interviewiq-server.onrender.com/api

VITE_API_URL=https://<YOUR_SERVER_URL>.onrender.com/api
